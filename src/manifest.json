
{
  "manifest_version": 3,
  "name": "Crypto Live",
  "version": "1.0.0",
  "description": "Rastreador de precios cripto en tiempo real utilizando la API de Binance.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.binance.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "livechart.png"
  },
  "icons": {
    "128": "livechart.png"
  }
}
